      "section": "4.1",
      "title": "Review first-aid information for potential skin exposure",
      "intended_effect": "applicable",
      "review_status": "unverified",
      "source": {
        "instrument": "internal_draft",
        "document_version": "0.2.0",
        "reference": "Demo workflow prompt — not a legal citation"
      },
      "effective_from": "2020-01-01",
      "effective_until": null,
      "when": {
        "all": [
          {
            "hazard_any": [
              "H315"
            ]
          },
          {
            "fact_equals": {
              "key": "skin_contact_possible",
              "value": "yes"
            }
          }
        ]
      }
    },
